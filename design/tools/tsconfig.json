{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "typeRoots": ["./node_modules/@types"],
    "baseUrl": ".",
    "paths": { "react": ["./node_modules/@types/react"], "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"] }
  },
  "include": ["../../src/components/icons/**/*", "../../src/components/brand/**/*"]
}
