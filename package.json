{
  "name": "suite-nothings",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node tools/postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:dev": "E2E_TARGET=dev playwright test",
    "e2e:live": "playwright test -c playwright.live.config.ts",
    "size": "node tools/size.mjs",
    "letter:gs": "node tools/make-letter-gs.mjs",
    "mock:api": "node tools/mock-apps-script.mjs"
  },
  "dependencies": {
    "@turf/along": "7.4.0",
    "@turf/bbox": "7.4.0",
    "@turf/bearing": "7.4.0",
    "@turf/distance": "7.4.0",
    "@turf/great-circle": "7.4.0",
    "@turf/helpers": "7.4.0",
    "@turf/length": "7.4.0",
    "exifr": "7.1.3",
    "gsap": "3.15.0",
    "idb": "8.0.3",
    "maplibre-gl": "6.11.2",
    "motion": "13.4.6",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.10.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.5",
    "globals": "17.12.0",
    "happy-dom": "20.14.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.3",
    "workbox-build": "7.4.1"
  }
}
