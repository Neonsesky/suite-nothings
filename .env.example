# Optional default Apps Script web-app URL. The link pasted in Settings → Connection always wins.
VITE_API_URL=
# Base path for the build. Leave empty locally ("/"); CI sets "/<repo-name>/".
VITE_BASE=
# Tests only: allow non-script.google.com API URLs (e.g. a local mock server). Never set in production.
VITE_ALLOW_LOCAL_API=
